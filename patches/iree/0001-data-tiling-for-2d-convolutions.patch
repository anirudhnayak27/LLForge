diff --git a/compiler/src/iree/compiler/DispatchCreation/SetEncoding.cpp b/compiler/src/iree/compiler/DispatchCreation/SetEncoding.cpp
index c3d1c45..6c1616f 100644
--- a/compiler/src/iree/compiler/DispatchCreation/SetEncoding.cpp
+++ b/compiler/src/iree/compiler/DispatchCreation/SetEncoding.cpp
@@ -14,6 +14,7 @@
 #include "iree/compiler/Dialect/LinalgExt/Utils/MatchUtils.h"
 #include "iree/compiler/DispatchCreation/FusionUtils.h"
 #include "iree/compiler/DispatchCreation/Passes.h"
+#include "llvm/ADT/DenseSet.h"
 #include "mlir/Dialect/Linalg/IR/Linalg.h"
 #include "mlir/Dialect/Linalg/Utils/Utils.h"
 #include "mlir/Dialect/MemRef/Transforms/Transforms.h"
@@ -70,6 +71,149 @@ getDataTilingCandidates(FunctionOpInterface funcOp) {
   return result;
 }
 
+/// The activation of a convolution with its constant spatial padding stripped
+/// off, see `getUnpaddedConvActivation`.
+struct UnpaddedConvActivation {
+  Value source;
+  // Symmetric padding per spatial dim, [padH, padW].
+  SmallVector<int64_t> padding;
+  // Unpadded spatial sizes [H, W]; empty if either is dynamic.
+  SmallVector<int64_t> inputHW;
+  // Unpadded input channel count, if static.
+  std::optional<int64_t> inputC;
+};
+
+/// If the activation (DPS input 0) of convolution `linalgOp` is a tensor.pad
+/// with a constant value, static symmetric padding on the two spatial dims and
+/// no padding on any other dim, returns its unpadded source and the padding.
+/// Encoding the unpadded tensor keeps the activation layout identical to the
+/// producer's tiled output, and the target applies the padding as a halo.
+/// Only linalg.generic convs are handled, since their indexing maps are
+/// rewritten afterwards (see `stripKernelOffsetsFromActivationMap`).
+static std::optional<UnpaddedConvActivation>
+getUnpaddedConvActivation(linalg::LinalgOp linalgOp) {
+  if (!isa<linalg::GenericOp>(linalgOp.getOperation()) ||
+      !linalg::isaConvolutionOpInterface(linalgOp)) {
+    return std::nullopt;
+  }
+  auto padOp = linalgOp.getDpsInputs()[0].getDefiningOp<tensor::PadOp>();
+  if (!padOp || !padOp.getConstantPaddingValue()) {
+    return std::nullopt;
+  }
+  FailureOr<linalg::ConvolutionDimensions> convDims =
+      linalg::inferConvolutionDims(linalgOp);
+  if (failed(convDims) || convDims->outputImage.size() != 2) {
+    return std::nullopt;
+  }
+
+  // Spatial results of the activation map are the ones that use an output
+  // image loop dim; the channel result uses the input channel loop dim.
+  AffineMap inMap =
+      linalgOp.getMatchingIndexingMap(linalgOp.getDpsInputOperand(0));
+  SmallVector<int64_t> spatialPos(2, -1);
+  std::optional<int64_t> chanPos;
+  for (auto [pos, expr] : llvm::enumerate(inMap.getResults())) {
+    for (auto [k, dim] : llvm::enumerate(convDims->outputImage)) {
+      if (expr.isFunctionOfDim(dim)) {
+        spatialPos[k] = pos;
+      }
+    }
+    if (convDims->inputChannel.size() == 1 &&
+        expr.isFunctionOfDim(convDims->inputChannel[0])) {
+      chanPos = pos;
+    }
+  }
+  if (spatialPos[0] < 0 || spatialPos[1] < 0 ||
+      spatialPos[0] == spatialPos[1]) {
+    return std::nullopt;
+  }
+
+  ArrayRef<int64_t> lows = padOp.getStaticLow();
+  ArrayRef<int64_t> highs = padOp.getStaticHigh();
+  if (lows.size() != highs.size() ||
+      static_cast<int64_t>(lows.size()) != inMap.getNumResults()) {
+    return std::nullopt;
+  }
+  for (auto [pos, low, high] : llvm::enumerate(lows, highs)) {
+    if (ShapedType::isDynamic(low) || ShapedType::isDynamic(high)) {
+      return std::nullopt;
+    }
+    bool isSpatial = static_cast<int64_t>(pos) == spatialPos[0] ||
+                     static_cast<int64_t>(pos) == spatialPos[1];
+    if (isSpatial ? low != high : (low != 0 || high != 0)) {
+      return std::nullopt;
+    }
+  }
+
+  UnpaddedConvActivation result;
+  result.source = padOp.getSource();
+  result.padding = {lows[spatialPos[0]], lows[spatialPos[1]]};
+  auto srcType = cast<RankedTensorType>(result.source.getType());
+  if (!srcType.isDynamicDim(spatialPos[0]) &&
+      !srcType.isDynamicDim(spatialPos[1])) {
+    result.inputHW = {srcType.getDimSize(spatialPos[0]),
+                      srcType.getDimSize(spatialPos[1])};
+  }
+  if (chanPos && !srcType.isDynamicDim(*chanPos)) {
+    result.inputC = srcType.getDimSize(*chanPos);
+  }
+  return result;
+}
+
+/// Drops the kernel-offset summands (terms using only filter loop dims, e.g.
+/// the `d3` in `d0 * 2 + d3`) from the activation indexing map of conv
+/// `linalgOp`, so the map's extent matches an unpadded activation.
+static void stripKernelOffsetsFromActivationMap(RewriterBase &rewriter,
+                                                linalg::GenericOp genericOp) {
+  FailureOr<linalg::ConvolutionDimensions> convDims =
+      linalg::inferConvolutionDims(
+          cast<linalg::LinalgOp>(genericOp.getOperation()));
+  if (failed(convDims)) {
+    return;
+  }
+  llvm::SmallDenseSet<unsigned> filterDims(convDims->filterLoop.begin(),
+                                           convDims->filterLoop.end());
+  auto isKernelOnly = [&](AffineExpr expr) {
