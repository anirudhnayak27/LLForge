+++ b/compiler/src/iree/compiler/Dialect/Encoding/IR/EncodingTypes.h
@@ -33,6 +33,20 @@ const int64_t SCALED_MATMUL_LHS_SCALES = 2;
 const int64_t SCALED_MATMUL_RHS_SCALES = 3;
 const int64_t SCALED_MATMUL_RESULT = 4;
 
+const int64_t CONV_LHS = 0;
+const int64_t CONV_RHS = 1;
+const int64_t CONV_RESULT = 2;
+
+/// Discardable attributes set by SetEncoding on a convolution whose padded
+/// activation was encoded without its padding:
+///   - kConvPaddingAttrName: symmetric spatial padding [padH, padW] that the
+///     target has to apply as a halo.
+///   - kConvInputHWAttrName: unpadded activation spatial sizes [H, W].
+///   - kConvInputCAttrName:  unpadded activation channel count.
+static constexpr char kConvPaddingAttrName[] = "iree_encoding.conv_padding";
+static constexpr char kConvInputHWAttrName[] = "iree_encoding.conv_input_hw";
+static constexpr char kConvInputCAttrName[] = "iree_encoding.conv_input_c";
+
 /// Convert operand index to strings for printing
 std::string stringifyOperandIndex(IntegerAttr);
 
diff --git a/compiler/src/iree/compiler/DispatchCreation/AnnotateDataTilingHints.cpp b/compiler/src/iree/compiler/DispatchCreation/AnnotateDataTilingHints.cpp
index f3c12ce..e70c6d5 100644
--- a/compiler/src/iree/compiler/DispatchCreation/AnnotateDataTilingHints.cpp
+++ b/compiler/src/iree/compiler/DispatchCreation/AnnotateDataTilingHints.cpp
@@ -23,6 +23,15 @@ namespace mlir::iree_compiler::DispatchCreation {
 #define GEN_PASS_DEF_ANNOTATEDATATILINGHINTSPASS
 #include "iree/compiler/DispatchCreation/Passes.h.inc"
 
+// Convolution data tiling is opt-in: the target's encoding resolver has to
+// know how to materialize `op_type = conv` encodings.
+static llvm::cl::opt<bool> clDataTilingConvs(
+    "iree-dispatch-creation-data-tiling-convs",
+    llvm::cl::desc("Also annotate 2D convolutions with data-tiling hints. "
+                   "Requires a target whose encoding resolver supports "
+                   "convolution encodings."),
+    llvm::cl::init(false));
+
 namespace {
 struct AnnotateDataTilingHintsPass final
     : impl::AnnotateDataTilingHintsPassBase<AnnotateDataTilingHintsPass> {
@@ -165,6 +174,29 @@ static bool isSupportedScaledContractionOp(linalg::LinalgOp linalgOp) {
   return true;
 }
 
+/// Returns true if `linalgOp` is a convolution that can be data-tiled:
+///   1) `linalgOp` meets the pre-conditions for data tiling defined in
+///      `dataTilablePreCondition`.
+///   2) `linalgOp` has convolution indexing maps with two output image dims
+///      and filter loops.
+///   3) `linalgOp` mixes channels (has both input and output channel dims),
+///      which excludes pooling and depthwise convolutions.
+static bool isSupportedConvolutionOp(linalg::LinalgOp linalgOp) {
+  if (!dataTilablePreCondition(linalgOp)) {
+    return false;
+  }
+  if (!linalg::isaConvolutionOpInterface(linalgOp)) {
+    return false;
+  }
+  FailureOr<linalg::ConvolutionDimensions> convDims =
+      linalg::inferConvolutionDims(linalgOp);
+  if (failed(convDims)) {
+    return false;
+  }
+  return convDims->outputImage.size() == 2 && !convDims->filterLoop.empty() &&
+         !convDims->inputChannel.empty() && !convDims->outputChannel.empty();
+}
+
 void AnnotateDataTilingHintsPass::runOnOperation() {
   FunctionOpInterface funcOp = getOperation();
   SmallVector<Operation *> candidates;
@@ -173,8 +205,10 @@ void AnnotateDataTilingHintsPass::runOnOperation() {
       return WalkResult::interrupt();
     }
     auto linalgOp = dyn_cast<linalg::LinalgOp>(op);
-    if (linalgOp && (isSupportedContractionOp(linalgOp) ||
-                     isSupportedScaledContractionOp(linalgOp))) {
+    if (linalgOp &&
+        (isSupportedContractionOp(linalgOp) ||
+         isSupportedScaledContractionOp(linalgOp) ||
+         (clDataTilingConvs && isSupportedConvolutionOp(linalgOp)))) {
       candidates.push_back(op);
       return WalkResult::advance();
     }
